{:id       :isaac.agent.schema-comms
 :version  "0.0.0"
 :builtin? true
 :factory  isaac.module.protocol/module
 :description "Test-only :comms config schema so agent CI matches the server-owned :comms shape without pulling isaac-http onto the classpath. The :isaac.agent/comm berth itself is declared by isaac-agent's real manifest (isaac-deds)."

 :isaac.config/schema
 {:comms {:schema {:name        "comms table"
                   :type        :map
                   :description "Communication channel configurations (map of name -> comm config)"
                   :key-spec    {:type :id}
                   :value-spec  {:name           :comm
                                 :type           :map
                                 :factory        isaac.comm.factory/create!
                                 :dynamic-schema {:berth :isaac.agent/comm :path [:extra-schema]}
                                 :schema         {:type {:type         :id
                                                         :options-from :comms
                                                         :description  "Manifest comm kind to instantiate"
                                                         :validations  [[:registered-in? :isaac.agent/comm [:comms]]]}
                                                  :crew {:type        :id
                                                         :description "Crew id this comm routes into"
                                                         :validations [:crew-exists?]}}}}}}}
