{:id :isaac.agent,
 :version "0.1.94",
 :builtin? true,
 :factory isaac.agent.module/create-module,
 :handbook "isaac/agent/handbook.md",
 :berths
 #:isaac.agent{:tools
               {:description "LLM tool factories.",
                :schema
                {:type :map,
                 :key-spec {:type :keyword},
                 :value-spec
                 {:type :map,
                  :factory isaac.agent.tool.registry/register-tool-entry!,
                  :schema
                  {:factory
                   {:type :symbol, :validations [:present?]}}}}},
               :tool-providers
               {:description
                "Dynamic tool providers — asked to register tools for an allowed namespace nobody registered (e.g. MCP servers declared in config). Entry: {:ensure! sym}, (ensure! ns-str module-index) => registered wire names or nil.",
                :schema
                {:type :map,
                 :key-spec {:type :keyword},
                 :value-spec
                 {:type :map,
                  :schema
                  {:ensure!
                   {:type :symbol, :validations [:present?]}}}}},
               :llm-api
               {:description
                "LLM API factories — adapters per provider API (messages, chat-completions, ollama, ...).",
                :schema
                {:type :map,
                 :key-spec {:type :keyword},
                 :value-spec
                 {:type :map,
                  :factory isaac.agent.llm.api.protocol/register-api-entry!,
                  :schema
                  {:factory
                   {:type :symbol, :validations [:present?]}}}}},
               :slash-commands
               {:description
                "Slash commands installed into the bridge slash registry.",
                :schema
                {:type :map,
                 :key-spec {:type :keyword},
                 :value-spec
                 {:type :map,
                  :factory isaac.agent.slash.registry/register-slash-entry!,
                  :schema
                  {:factory
                   {:type :symbol, :validations [:present?]}}}}},
               :provider
               {:description
                "Materialized LLM providers — instances usable by models. Manifest contributions are third-party modules shipping a ready-to-use provider; user-instantiated providers in the [:providers] config slot also count toward this berth (see `[:registered-in? :isaac.agent/provider [:providers]]` use sites).",
                :schema
                {:type :map,
                 :key-spec {:type :keyword},
                 :value-spec {:type :map}}},
               :provider-template
               {:description
                "Provider templates — partial provider configs that user-config :providers entries can inherit from via :type.",
                :schema
                {:type :map,
                 :key-spec {:type :keyword},
                 :value-spec
                 {:type :map, :schema {:template {:type :map}}}}},
                :resource-pool-types
                {:description
                 "Named resource pool type factories. Modules contribute by name; submitters reference names as data. Registration is not activation.",
                 :schema
                 {:type :map,
                  :key-spec {:type :keyword},
                  :value-spec
                  {:type :map,
                   :factory isaac.agent.resource-pool/register-entry!,
                   :schema
                   {:factory
                    {:type :symbol, :validations [:present?]}}}}},
               :session-policy
               {:description
                "Named session-policy factories. A crew selects with :session-policy; absent is chronicle. Factories receive the root session store.",
                :schema
                {:type :map,
                 :key-spec {:type :keyword},
                 :value-spec
                 {:type :map,
                  :factory isaac.agent.session.policy/register-entry!,
                  :schema
                  {:factory
                   {:type :symbol, :validations [:present?]}}}}}
               :comm
               {:description "Communication channels (Discord, iMessage, ACP, …). Manifest contributions name available impls and carry the impl's :namespace (whose load implements isaac.agent.comm.factory/create for that :type) plus its :extra-schema (extension fields composed into [:comms] slots of that :type). User-instantiated comm slots in the [:comms] config slot also count toward this berth, so `[:registered-in? :isaac.agent/comm [:comms]]` accepts both manifest impl ids (the common :type values) and slot ids. :register-fn wires each live slot into comm-registry so the delivery worker can send outbound replies.",
                :register-fn   isaac.agent.comm.registry/register-instance!
                :deregister-fn isaac.agent.comm.registry/deregister-instance!
                :schema      {:type       :map
                              :key-spec   {:type :keyword}
                              :value-spec {:type    :map
                                           :schema  {:namespace     {:type :symbol :validations [:present?]}
                                                     :extra-schema  {:type :schema-map}
                                                     :send-schema   {:type :schema-map}
                                                     :send-attachments? {:type :boolean}
                                                     :configurable? {:type :boolean}}}}}},
 :isaac/component
 {:agent-lifecycle {:namespace isaac.agent.component}
  :comm-delivery   {:namespace isaac.agent.component}
  :turn-queue      {:namespace isaac.agent.component}}

 :isaac/cli
 {:auth
  {:usage "auth <subcommand> [options]",
   :summary "Manage authentication credentials",
   :namespace isaac.agent.llm.auth.cli
   :hosted true},
  :crew
  {:usage "crew [subcommand] [options]",
   :summary "Manage configured crew members",
   :namespace isaac.agent.crew.cli
   :hosted true},
  :prompt
  {:usage "prompt -m <message> [options]",
   :summary "Run a single prompt turn and exit",
   :namespace isaac.agent.bridge.prompt-cli
   :hosted true},
  :turns
  {:usage "turns [subcommand] [options]",
   :summary "Inspect and evict held turn requests",
   :namespace isaac.agent.turn.cli
   :hosted true},
  :sessions
  {:usage "sessions [subcommand] [options]",
   :summary "Manage stored conversation sessions",
   :namespace isaac.agent.session.cli
   :hosted true}},
 :isaac.agent/llm-api
 {:messages {:factory isaac.agent.llm.api.messages/make},
  :grover {:factory isaac.agent.llm.api.grover/make},
  :ollama {:factory isaac.agent.llm.api.ollama/make},
  :chat-completions {:factory isaac.agent.llm.api.chat-completions/make},
  :responses {:factory isaac.agent.llm.api.responses/make}},
 :isaac.agent/tools
 {:web/fetch {:factory isaac.agent.tool.builtin/web-fetch-tool-factory},
  :fs/read {:factory isaac.agent.tool.builtin/read-tool-factory},
  :exec/run {:factory isaac.agent.tool.builtin/exec-tool-factory},
  :session/model
  {:factory isaac.agent.tool.builtin/session-model-tool-factory},
  :fs/grep {:factory isaac.agent.tool.builtin/grep-tool-factory},
  :fs/edit {:factory isaac.agent.tool.builtin/edit-tool-factory},
  :fs/multi_edit {:factory isaac.agent.tool.builtin/multi-edit-tool-factory},
  :memory/write
  {:factory isaac.agent.tool.builtin/memory-write-tool-factory},
  :web/search {:factory isaac.agent.tool.builtin/web-search-tool-factory},
  :turn/get {:factory isaac.agent.tool.builtin/turn-get-tool-factory},
  :session/info
  {:factory isaac.agent.tool.builtin/session-info-tool-factory},
  :fs/write {:factory isaac.agent.tool.builtin/write-tool-factory},
  :fs/glob {:factory isaac.agent.tool.builtin/glob-tool-factory},
  :memory/search
  {:factory isaac.agent.tool.builtin/memory-search-tool-factory},
  :prompt/load {:factory isaac.agent.tool.prompt/load-prompt-tool-factory},
  :prompt/list {:factory isaac.agent.tool.prompt/list-prompts-tool-factory},
  :memory/get {:factory isaac.agent.tool.builtin/memory-get-tool-factory},
  :comm/send {:factory isaac.agent.tool.comm-send/comm-send-tool-factory}},
 :isaac.agent/provider-template
 {:anthropic
  {:template
   {:api "messages",
    :base-url "https://api.anthropic.com",
    :auth "api-key"}},
  :xai
  {:template
   {:api "chat-completions",
    :base-url "https://api.x.ai/v1",
    :auth "api-key"}},
  :grover {:template {:api "grover", :auth "none"}},
  :ollama
  {:template
   {:api "ollama", :base-url "http://localhost:11434", :auth "none"}},
  :openai
  {:template
   {:api "chat-completions",
    :base-url "https://api.openai.com/v1",
    :auth "api-key"}},
  :chatgpt
  {:template
   {:api "responses",
    :base-url "https://chatgpt.com/backend-api/codex",
    :auth "oauth-device",
    :oauth {:issuer "https://auth.openai.com"
            :client-id "app_EMoamEEZ73f0CkXaXp7hrann"
            :device-path "/api/accounts/deviceauth/usercode"
            :poll-path "/api/accounts/deviceauth/token"
            :token-path "/oauth/token"
            :redirect-uri "https://auth.openai.com/deviceauth/callback"
            :verification-url "https://auth.openai.com/codex/device"
            :flow :openai-device-auth
            :originator "isaac"
            :chatgpt-account-id? true
            :token-exchange {:requested-token "openai-api-key"
                             :subject-token-type "urn:ietf:params:oauth:token-type:id_token"}}}}
  :grok
  {:template
   {:api "chat-completions",
    :base-url "https://api.x.ai/v1",
    :auth "oauth-device",
    :oauth {:issuer "https://auth.x.ai"
            :client-id "b1a00492-073a-47ea-816f-4c329264a828"
            :device-path "/oauth2/device/code"
            :token-path "/oauth2/token"
            :verification-url "https://accounts.x.ai/oauth2/device"
            :flow :oidc-device-code
            :scope "api:access offline_access"}}}},
 :isaac.agent/slash-commands
 {:crew {:factory isaac.agent.slash.builtin/crew-command},
  :cwd {:factory isaac.agent.slash.builtin/cwd-command},
  :effort {:factory isaac.agent.slash.builtin/effort-command},
  :model {:factory isaac.agent.slash.builtin/model-command},
  :status {:factory isaac.agent.slash.builtin/status-command}},
 :isaac.config/schema
 {:bridge
  {:schema
   {:name :bridge,
    :type :map,
    :description "Turn bridge configuration",
    :schema
    {:suspend-timeout-ms
     {:type :int,
      :description "Milliseconds to wait while suspending active turns"}}}},
  :resource-pools
  {:entity-dir "resource-pools"
   :merge-root-entity? true
   :schema {:type :map :key-spec {:type :string}
            :description "Named admission gates a turn leases before it runs (map of pool id -> pool config); a busy pool parks the turn on the turn queue until it frees."
            :value-spec {:type :map
                         :schema {:type {:type :keyword
                                         :description "Pool behavior/factory id, e.g. :tide (a clock-window gate); registered via the :isaac.agent/resource-pool-types berth."}
                                  :window {:type :string
                                           :description "For :tide pools: an \"HH:mm-HH:mm\" clock range (wraparound allowed) during which the pool admits turns."}
                                  :name {:type :string
                                         :description "Display name for this pool instance, passed through to its factory."}
                                  :limit {:type :int
                                          :description "Concurrency cap interpreted by the pool's own factory (not used by :tide)."}
                                  :members {:type :seq :spec {:type :string}
                                            :description "Member resource paths this pool coordinates access to, for pool types that gate a shared list of resources."}}}}},
  :providers
  {:entity-dir "providers",
   :merge-root-entity? true,
   :schema
   {:name "provider table",
    :type :map,
    :snapshot-only? true,
    :description
    "Provider configurations (map of id -> provider config)",
    :key-spec {:type :id},
    :value-spec
    {:name :provider,
     :type :map,
     :dynamic-schema
     {:berth :isaac.agent/provider-template, :path [:schema]},
     :schema
     {:effort
      {:type :int,
       :description "Effort level for this provider (0-10)"},
      :assistant-base-url
      {:type :string, :description "Base URL for assistant endpoints"},
      :supports-system-role
      {:type :boolean,
       :description
       "Whether the provider accepts a system role message"},
      :api
      {:type :id,
       :description
       "Provider API adapter (e.g. \"anthropic\", \"ollama\")",
       :validations [[:registered-in? :isaac.agent/llm-api]]},
      :name {:type :string, :description "Display name"},
      :response-format
      {:type :string, :description "Response format hint"},
      :type
      {:type :id,
       :description "Manifest provider id to inherit template from",
       :validations
       [[:registered-in? :isaac.agent/provider-template]]},
      :auth
      {:type :string,
       :description "Authentication mode (e.g. \"oauth-device\")"},
      :base-url {:type :string, :description "API base URL"},
      :headers
      {:type :map,
       :description "Extra HTTP headers to include in requests",
       :key-spec {:type :string},
       :value-spec {:type :string}},
      :oauth
      {:type :map,
       :description "OAuth device-code/provider descriptor metadata",
       :schema {:issuer {:type :string}
                :client-id {:type :string}
                :device-path {:type :string}
                :poll-path {:type :string}
                :token-path {:type :string}
                :redirect-uri {:type :string}
                :verification-url {:type :string}
                :flow {:type :keyword}
                :scope {:type :string}
                :originator {:type :string}
                :chatgpt-account-id? {:type :boolean}
                :token-exchange {:type :map
                                 :schema {:requested-token {:type :string}
                                          :subject-token-type {:type :string}}}}},
      :token
      {:type :string,
       :description "Authentication token (alias for api-key)"},
      :models
      {:type :seq,
       :description "Canonical model ids served by this provider",
       :spec {:type :string}},
      :auth-key {:type :string, :description "Authentication key"},
      :history-retention
      {:type :keyword,
       :description
       "Transcript history retention policy for sessions created against this provider",
       :validations [[:one-of? :prune :retain]]},
      :id
      {:type :id,
       :description "Provider id; must match filename when present"},
      :stream-supports-tool-calls
      {:type :boolean,
       :description "Whether streaming mode supports tool calls"},
      :stream-non-tool-turns
      {:type :boolean,
       :description "Use chat-stream for turns without tools (claude-cli)"},
      :command
      {:type :string,
       :description "CLI binary path for claude-cli shell-out"},
      :extra-args
      {:type :seq,
       :description "Extra CLI args forwarded before the prompt (claude-cli)",
       :spec {:type :string}},
      :compaction
      {:type :map,
       :description "Compaction policy override for this provider",
       :schema
       {:async? {:type :boolean
                 :description "Run compaction in a background thread instead of blocking the current turn; a per-session lock coordinates transcript appends with the splice."},
        :effort
        {:type :int,
         :description
         "Effort used for compaction summary requests (default 2)"},
        :head
        {:type :double,
         :description "Fraction of the context window's worth of recent transcript kept intact (uncompacted) under the :slinky strategy (default 0.3)."
         :validations
         [[:percentage? "e.g. 0.3 for 30% of context-window"]]},
        :head-threshold
        {:type :ignore,
         :description "Derived: head must stay below threshold",
         :validations [[:less-than? :head :threshold]]},
        :strategy
        {:type :keyword,
         :description "How compaction folds transcript history when the gauge crosses :threshold: :rubberband compacts everything compactable in one shot; :slinky compacts only the older portion, leaving the most recent :head fraction of the window intact."
         :validations [[:one-of? :rubberband :slinky]]},
        :threshold
        {:type :double,
         :description "Fraction of the model's context window that, once the running token gauge reaches or exceeds it, triggers compaction (default 0.8)."
         :validations
         [[:percentage? "e.g. 0.8 for 80% of context-window"]]}}},
      :originator
      {:type :string, :description "X-Originator header value"},
      :api-key
      {:type :string,
       :description "API key",
       :validations [[:present-when? :auth "api-key"]]},
      :stream-idle-timeout-ms
      {:type :int,
       :default 90000,
       :description
       "Idle-stall timeout (ms) for this provider's SSE/NDJSON streams; close and treat as weather when no bytes arrive"},
      :retry-after-ms
      {:type :int,
       :default 1800000,
       :description
       "Retry-after (ms) when a wall from this provider carries no Retry-After header"},
      :auth-retry-ms
      {:type :int,
       :default 300000,
       :description
       "Retry-after (ms) when an auth failure from this provider blocks a turn"}}}}},
  :skill-menu-threshold
  {:schema
   {:type :int,
    :description
    "Max skill count to inject into the cached prompt before falling back to prompt__list",
    :validations [:non-negative?]}},
  :tools
  {:schema
   {:type :map,
    :description "Per-tool configuration (crew-wide tool defaults live at :defaults :crew :tools, output caps at :defaults :tools)",
    :schema
    {:max-parallel
     {:type :int,
      :description "Retired: crew-wide max concurrent tool calls now lives at :defaults :crew :tools :max-parallel."
      :validations [[:retired? "use :defaults :crew :tools :max-parallel"]]}
     :defaults
     {:type :map,
      :description "Retired: per-tool defaults now live at :defaults :tools."
      :validations [[:retired? "use :defaults :tools"]]}
     :web_search
     {:type :map,
      :description "Web search tool config",
      :schema
      {:provider {:type :keyword, :description "Web search backend to use (only :brave is registered)." :validations [[:one-of? :brave]]},
       :api-key {:type :string, :description "API key for the configured web search provider." :validations [:present?]}}}
     :allow
     {:type :ignore,
      :description "Retired: tool allow list now lives at :defaults :crew :tools :allow."
      :validations [[:retired? "use :defaults :crew :tools :allow"]]}
     :deny
     {:type :ignore,
      :description "Retired: tool deny list now lives at :defaults :crew :tools :deny."
      :validations [[:retired? "use :defaults :crew :tools :deny"]]}
     :directories
     {:type :map,
      :description "Retired: tool directory overlay now lives at :defaults :crew :tools :directories."
      :validations [[:retired? "use :defaults :crew :tools :directories"]]}}}},
  :crew
  {:entity-dir "crew",
   :frontmatter? true,
   :merge-root-entity? true,
   :companion {:field :soul, :mode :exclusive},
   :schema
   {:name "crew table",
    :type :map,
    :snapshot-only? true,
    :description
    "Crew member configurations (map of id -> crew config)",
    :key-spec {:type :id},
    :value-spec
    {:name :crew,
     :type :map,
     :schema
     {:tags
      {:type :ignore,
       :set-type? true,
       :description
       "Flat set of keyword tags for discovery and routing",
       :validations [:keyword-set?]},
      :effort
      {:type :int,
       :description
       "Effort level override for this crew member (0-10)"},
      :tools
      {:name :tools,
       :type :map,
       :description "Tool configuration",
       :schema
       {:allow
        {:type :ignore,
         :description "Allowed tools: :all or a vector of namespaced keywords / ns/* globs"},
        :deny
        {:type :ignore,
         :description "Denied tools: :all or a vector of namespaced keywords / ns/* globs"},
        :max-parallel
        {:type :int,
         :description "Crew override for max concurrent tool calls from one model response batch",
         :validations [:positive?]},
        :directories
        {:type :map,
         :description
         "Crew directory overlay. :allow/:deny of :cwd, :quarters, or absolute paths. Overlay, not replace.",
         :schema
         {:allow
          {:type :seq,
           :description "Allowed directory prefixes",
           :spec {:type :ignore, :validations [:cwd-or-path?]}},
          :acknowledge-broad?
          {:type :boolean,
           :description "Suppress deliberate broad-directory grant warnings for this crew"}
          :deny
          {:type :seq,
           :description "Denied directory prefixes",
           :spec {:type :ignore, :validations [:cwd-or-path?]}}}}}},
      :cwd
      {:type :string,
       :description "Default workdir for new sessions on this crew",
       :validations [:absolute-path?]},
      :soul
      {:type :string,
       :description
       "The personality of this crew member. Alternatively saved at config/crew/<id>.md"},
      :history-retention
      {:type :keyword,
       :description
       "Transcript history retention policy for new sessions",
       :validations [[:one-of? :prune :retain]]},
      :id
      {:type :id,
       :description
       "Crew member id; must match filename when present"},
      :context-mode
      {:type :keyword,
       :description "How much transcript history to replay each turn",
       :validations [[:one-of? :full :reset]]},
      :provider
      {:type :id,
       :description "Provider id for direct provider/model crews",
       :validations
       [[:registered-in? :isaac.agent/provider [:providers]]]},
      :compaction
      {:type :map,
       :description "Compaction policy override for this crew",
       :schema
       {:async? {:type :boolean
                 :description "Run compaction in a background thread instead of blocking the current turn; a per-session lock coordinates transcript appends with the splice."},
        :effort
        {:type :int,
         :description
         "Effort used for compaction summary requests (default 2)"},
        :head
        {:type :double,
         :description "Fraction of the context window's worth of recent transcript kept intact (uncompacted) under the :slinky strategy (default 0.3)."
         :validations
         [[:percentage? "e.g. 0.3 for 30% of context-window"]]},
        :head-threshold
        {:type :ignore,
         :description "Derived: head must stay below threshold",
         :validations [[:less-than? :head :threshold]]},
        :strategy
        {:type :keyword,
         :description "How compaction folds transcript history when the gauge crosses :threshold: :rubberband compacts everything compactable in one shot; :slinky compacts only the older portion, leaving the most recent :head fraction of the window intact."
         :validations [[:one-of? :rubberband :slinky]]},
        :threshold
        {:type :double,
         :description "Fraction of the model's context window that, once the running token gauge reaches or exceeds it, triggers compaction (default 0.8)."
         :validations
         [[:percentage? "e.g. 0.8 for 80% of context-window"]]}}},
      :max-in-flight
      {:type :ignore,
       :description "Retired: the crew-wide in-flight cap is gone; turns serialize per session only."
       :validations
       [[:retired? "the crew-wide in-flight cap is gone (isaac-ximd); turns serialize per session only"]]},
      :cycle
      {:type :map,
       :description
       "Turn knobs: limit (was :cycle-limit), checkpoint-every, checkpoint-prompt, wrap-up-prompt, continuations",
       :schema
       {:limit
        {:type :int,
         :description "Tool-call cycle budget for turns on this crew (default 100)"},
        :checkpoint-every
        {:type :int,
         :description "Nudge a checkpoint every N cycles; omit to leave checkpoints off"},
        :checkpoint-prompt
        {:type :string,
         :description "Optional override of the drive's default checkpoint nudge"},
        :wrap-up-prompt
        {:type :string,
         :description "Optional override of the drive's default wrap-up nudge"},
        :continuations
        {:type :int,
         :description "How many times a wrapped-up turn may be re-driven on this crew (default 2)"}}},
      :model
      {:type :id,
       :description "ID of the model this crew member uses.",
       :validations [:model-exists?]},
      :session-policy
      {:type :keyword,
       :description
       "Session policy over the primitive store: :chronicle (default) or :episodes"}}}}},
  :prompt-paths
  {:schema
   {:type :seq,
    :description "Extra roots to scan for prepared prompts",
    :spec {:type :string}}},
  :defaults
  {:schema
   {:name :defaults,
    :type :map,
    :description
    "Entity templates. :defaults :<entity> behaves exactly as if every entity of that kind had set the field, so where a default is written decides how it ranks: :defaults :provider :effort is outranked by a model's or crew's effort, while :defaults :crew :effort outranks every model's. To keep a field's existing rank, write its default on the lowest layer that carries it.",
    :schema
    {:frequencies
     {:type :map,
      :description
      "Default session selection (selection fields only; the per-turn :with-* overrides sit above every layer and are never defaults)",
      :entity-template
      {:kind :frequencies,
       :except [:with-crew :with-model :with-effort :with-context-mode],
       :override
       {:crew
        {:type :id,
         :required true,
         :description "Default crew member id",
         :validations [:present? :crew-exists?]}}}},
     :crew
     {:type :map,
      :message
      "must be a map of crew defaults; the default crew id moved to :defaults :frequencies :crew",
      :description "Template for every crew member",
      :entity-template {:kind :crew, :except [:id :soul :tags]}},
     :model
     {:type :map,
      :message
      "must be a map of model defaults; the default model alias moved to :defaults :crew :model",
      :description "Template for every model",
      :entity-template {:kind :models, :except [:id]}},
     :provider
     {:type :map,
      :description "Template for every provider",
      :entity-template {:kind :providers, :except [:id :name]}},
     :tools
     {:type :map,
      :description "Global tool output caps applied at the turn boundary",
      :schema
      {:max-lines
       {:type :int,
        :description "Max lines in a tool result string before head-tail truncation"},
       :max-bytes
       {:type :int,
        :description "Max UTF-8 bytes in a tool result string before head-tail truncation"}}},
     :context-mode
     {:type :keyword,
      :description "Retired: default context mode now lives at :defaults :crew :context-mode."
      :validations [[:retired? "use :defaults :crew :context-mode"]]},
     :cycle
     {:type :map,
      :description "Retired: default cycle knobs now live at :defaults :crew :cycle."
      :validations [[:retired? "use :defaults :crew :cycle"]]},
     :effort
     {:type :int,
      :description "Retired: default effort now lives at :defaults :provider :effort."
      :validations [[:retired? "use :defaults :provider :effort"]]},
     :history-retention
     {:type :keyword,
      :description "Retired: default history retention now lives at :defaults :provider :history-retention."
      :validations [[:retired? "use :defaults :provider :history-retention"]]},
     :compaction
     {:type :map,
      :description "Retired: default compaction policy now lives at :defaults :provider :compaction."
      :validations [[:retired? "use :defaults :provider :compaction"]]},
     :stream-idle-timeout-ms
     {:type :int,
      :description "Retired: default stream idle timeout now lives at :defaults :provider :stream-idle-timeout-ms."
      :validations [[:retired? "use :defaults :provider :stream-idle-timeout-ms"]]},
     :provider-retry-after-ms
     {:type :int,
      :description "Retired: default provider retry-after now lives at :defaults :provider :retry-after-ms."
      :validations [[:retired? "use :defaults :provider :retry-after-ms"]]},
     :provider-auth-retry-ms
     {:type :int,
      :description "Retired: default provider auth-retry now lives at :defaults :provider :auth-retry-ms."
      :validations [[:retired? "use :defaults :provider :auth-retry-ms"]]}}}},
  :attention
  {:schema
   {:name :attention,
    :type :map,
    :description "System-scoped attention routing for operator outages",
    :schema
    {:notify
     {:type :map,
      :description "Default notification channel for system-scoped attention",
      :schema
      {:comm {:type :string, :description "Comm id to deliver attention messages"},
       :target {:type :string, :description "Comm-specific target (channel, user, etc.)"}}},
     :break-glass
     {:type :map,
      :description "Break-glass attention channel (declared; unused in 5a4n)",
      :schema
      {:comm {:type :string :description "Comm id to deliver break-glass attention messages"},
       :target {:type :string :description "Comm-specific target (channel, user, etc.)"}}}}}},
  :skill-paths
  {:schema
   {:type :seq,
    :description "Extra typed roots to scan for prepared skills",
    :spec {:type :string}}},
  :models
  {:entity-dir "models",
   :merge-root-entity? true,
   :schema
   {:name "model table",
    :type :map,
    :snapshot-only? true,
    :description "Model configurations (map of id -> model config)",
    :key-spec {:type :id},
    :value-spec
    {:name :model,
     :type :map,
     :schema
     {:effort
      {:type :int,
       :description "Effort level override for this model (0-10)"},
      :thinking-budget-max
      {:type :int,
       :description
       "Anthropic: max thinking budget tokens at effort=10; scales linearly. Default 32000."},
      :allows-effort
      {:type :boolean,
       :description
       "Whether to attach :effort to requests for this model (default true)"},
      :stateful
      {:type :boolean,
       :description
       "Responses API: chain tool-loop cycles with previous_response_id + store:true when true (default false)"},
      :history-retention
      {:type :keyword,
       :description
       "Transcript history retention policy for sessions created against this model",
       :validations [[:one-of? :prune :retain]]},
      :id
      {:type :id,
       :description "Model alias; must match filename when present"},
      :provider
      {:type :id,
       :description "Provider alias",
       :validations
       [[:registered-in? :isaac.agent/provider [:providers]]],
       :required true},
      :context-window
      {:type :int, :description "Context window size in tokens"},
      :think-mode
      {:type :keyword,
       :description
       "Ollama: how :effort is translated. :bool (default) → think true/false; :levels → \"low\"|\"medium\"|\"high\"."},
      :compaction
      {:type :map,
       :description "Compaction policy override for this model",
       :schema
       {:async? {:type :boolean
                 :description "Run compaction in a background thread instead of blocking the current turn; a per-session lock coordinates transcript appends with the splice."},
        :effort
        {:type :int,
         :description
         "Effort used for compaction summary requests (default 2)"},
        :head
        {:type :double,
         :description "Fraction of the context window's worth of recent transcript kept intact (uncompacted) under the :slinky strategy (default 0.3)."
         :validations
         [[:percentage? "e.g. 0.3 for 30% of context-window"]]},
        :head-threshold
        {:type :ignore,
         :description "Derived: head must stay below threshold",
         :validations [[:less-than? :head :threshold]]},
        :strategy
        {:type :keyword,
         :description "How compaction folds transcript history when the gauge crosses :threshold: :rubberband compacts everything compactable in one shot; :slinky compacts only the older portion, leaving the most recent :head fraction of the window intact."
         :validations [[:one-of? :rubberband :slinky]]},
        :threshold
        {:type :double,
         :description "Fraction of the model's context window that, once the running token gauge reaches or exceeds it, triggers compaction (default 0.8)."
         :validations
         [[:percentage? "e.g. 0.8 for 80% of context-window"]]}}},
      :model
      {:type :string,
       :description "Provider-specific model name or id",
       :required true}}}}},
  :command-paths
  {:schema
   {:type :seq,
    :description "Extra typed roots to scan for prepared commands",
    :spec {:type :string}}},
  :frequencies
  {:schema
   {:name :frequencies,
    :type :map,
    :description
    "Session frequencies map (selection + override); shared by CLI, hail, cron, and config consumers",
    :schema
    {:session
     {:type :seq,
      :description "Explicit session id(s)",
      :spec {:type :string}},
     :session-tags
     {:type :seq,
      :description "Tags sessions must carry (AND)",
      :spec {:type :keyword}},
     :crew
     {:type :string,
      :description "Sessions whose :crew matches this id"},
     :prefer
     {:type :keyword,
      :description "Multi-match tiebreak",
      :validations [[:one-of? :recent :oldest]]},
     :create
     {:type :keyword,
      :description "Create policy: :never, :if-missing, or :always",
      :validations [[:one-of? :never :if-missing :always]]},
     :with-crew
     {:type :string,
      :description "Override crew for this turn"},
     :with-model
     {:type :string,
      :description "Override model for this turn"},
     :with-effort
     {:type :int,
      :description "Override effort for this turn"},
     :with-context-mode
     {:type :keyword,
      :description "Override context mode for this turn"}}}}
  :sessions
  {:schema
   {:name :sessions,
    :type :map,
    :description "Session storage configuration",
    :schema
    {:naming-strategy
     {:type :ignore,
      :description "Session naming strategy",
      :validations [:keyword-or-string?]},
     :store
     {:type :keyword,
      :description
      "Session store implementation: :memory, :ednl-dir (default)"}}}},
  :prompt-dir-names
  {:schema
   {:type :map,
    :description
    "Directory-name to prompt-type mapping for prepared prompts",
    :key-spec {:type :string},
    :value-spec {:type :string}}},
  :comms
  {:schema {:name        "comms table"
            :type        :map
            :description "Communication channel configurations (map of name -> comm config)"
            :key-spec    {:type :id}
            :value-spec  {:name           :comm
                          :type           :map
                          :factory        isaac.agent.comm.factory/create!
                          :dynamic-schema {:berth :isaac.agent/comm :path [:extra-schema]}
                          :schema         {:type {:type         :id
                                                  :options-from :comms
                                                  :description  "Manifest comm kind to instantiate"
                                                  :validations  [[:registered-in? :isaac.agent/comm [:comms]]]}
                                           :crew {:type        :id
                                                  :description "Crew id this comm routes into"
                                                  :validations [:crew-exists?]}}}}}}

 :isaac.agent/session-policy
 {:chronicle {:factory isaac.agent.session.policy.chronicle/create}}

